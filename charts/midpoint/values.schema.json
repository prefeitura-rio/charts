{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "database": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "connector": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "required": ["name", "url", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schemaExtension": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "files": { "type": "object" },
        "existingConfigMap": { "type": "string" }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "anyOf": [
          { "properties": { "existingConfigMap": { "type": "string", "minLength": 1 } }, "required": ["existingConfigMap"] },
          { "properties": { "files": { "type": "object", "minProperties": 1 } }, "required": ["files"] }
        ]
      }
    },
    "resourcesImport": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "files": { "type": "object" },
        "existingConfigMap": { "type": "string" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "endpoint"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "endpoint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "substitutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["placeholder", "valueFrom"],
            "properties": {
              "placeholder": { "type": "string", "minLength": 1 },
              "valueFrom": { "type": "object" }
            }
          }
        }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "required": ["objects"],
        "properties": {
          "objects": { "type": "array", "minItems": 1 }
        },
        "anyOf": [
          { "properties": { "existingConfigMap": { "type": "string", "minLength": 1 } }, "required": ["existingConfigMap"] },
          { "properties": { "files": { "type": "object", "minProperties": 1 } }, "required": ["files"] }
        ]
      }
    }
  }
}
